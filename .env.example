# PiGreco Posta: copiare in .env e compilare (oppure lanciare ./installa.sh,
# che crea .env da questo file con password casuali).
# .env contiene password: non va mai pubblicato.

TZ=Europe/Rome

# ---------- Webmail ----------
# Indirizzo: http://<ip-server>:WEBMAIL_PORT/webmail/
WEBMAIL_PORT=8080
# 0.0.0.0 = webmail raggiungibile da tutta la rete. 127.0.0.1 = porta chiusa
# alla rete: si usa quando c'è PiGreco Archivio, che la pubblica su
# http://<ip-server>:8081/webmail/ (manuale, paragrafo 13)
WEBMAIL_ASCOLTO=0.0.0.0

# Password di root del MySQL della webmail (serve solo al container per
# creare database e utente al primo avvio)
DB_ROOT_PASS=

# Database e utente MySQL della webmail
WEBMAIL_DB_NAME=webmail_digitale
WEBMAIL_DB_USER=webmail_user
WEBMAIL_DB_PASS=

# Chiave che cifra le password IMAP/SMTP salvate negli account (32 byte in
# base64). Generarla con:  openssl rand -base64 32
# NON cambiarla dopo aver creato gli account: le password non sarebbero più
# leggibili e andrebbero reinserite.
WEBMAIL_ENCRYPTION_KEY=

# Cartella dei file di MySQL: dentro quella della posta, così caselle e
# database stanno in un solo posto (backup: ./scripts/backup.sh)
WEBMAIL_DB_DIR=/srv/posta/mysql

# Server IMAP proposto per i nuovi account: "posta" è la copia locale delle
# caselle di questo stesso compose (porta interna 143). Per leggere da un
# altro server IMAP indicarne qui nome e porta.
WEBMAIL_IMAP_HOST=posta
WEBMAIL_IMAP_PORT=143
WEBMAIL_IMAP_SECURITY=starttls
# 1 = verifica il certificato TLS del server IMAP (0 se è autofirmato, come
# quello creato da "posta" al primo avvio)
WEBMAIL_IMAP_TLS_VERIFY=0

# Collegamento con PiGreco Archivio: lasciare vuoto. Installato sullo stesso
# server, l'archivio si fa riconoscere da solo (manuale, paragrafo 13).
# "/" = webmail sempre collegata all'archivio, anche dalla sua porta.
ARCHIVIO_URL=

# Secondo fattore: codice a 6 cifre dell'app Authenticator dopo la password.
#   mai    = solo password
#   fuori  = codice solo per chi entra da fuori WEBMAIL_RETI_INTERNE
#   sempre = codice per tutti
WEBMAIL_TOTP=mai
# Reti dell'ufficio (con "fuori"), separate da virgole; "!" esclude, per
# esempio il router se gli accessi da Internet arrivano con il suo indirizzo:
#   WEBMAIL_RETI_INTERNE=192.168.1.0/24,!192.168.1.1
WEBMAIL_RETI_INTERNE=
# Nome della riga nell'app Authenticator
WEBMAIL_TOTP_NOME=PiGreco Posta
# Percorso dei cookie della webmail: "/" se l'indirizzo serve solo la
# webmail, "/webmail/" se serve anche altri programmi
WEBMAIL_COOKIE_PATH=/

# ---------- Copia locale delle caselle ----------
# Cartella dei dati (caselle con le loro Maildir, account.conf, certificato):
# creata e assegnata a 5000:5000 dal container se non esiste. /srv/posta come
# in PiGreco Archivio; con un disco dedicato ai dati montarlo lì prima del
# primo avvio. Nei container è sempre /srv/posta: per spostarla basta fermare
# i servizi, spostare la cartella e cambiare questa riga.
POSTA_DIR=/srv/posta

# Porte IMAP (STARTTLS) e IMAPS (SSL) per telefoni e programmi di posta.
# Sono quelle standard: cambiarle solo se sul server gira già un altro
# server IMAP (es. 1143 e 1993).
POSTA_IMAP_PORT=143
POSTA_IMAPS_PORT=993
# 0.0.0.0 = IMAP raggiungibile dalla rete; 127.0.0.1 = solo dal server (la
# webmail lo usa comunque dalla rete interna di Docker): quando la posta si
# legge solo dalla webmail
POSTA_IMAP_ASCOLTO=0.0.0.0

# Pagina web "Gestione caselle"
POSTA_GESTIONE_PORT=8083
# Da dove si apre: 0.0.0.0 = da tutta la rete, 127.0.0.1 = solo dal server
# (da fuori con un tunnel SSH), oppure l'IP del server nella rete dell'ufficio
POSTA_GESTIONE_ASCOLTO=0.0.0.0

# Nome nel certificato autofirmato creato al primo avvio
POSTA_NOME_SERVER=posta.locale

# Secondi tra una sincronizzazione e la successiva
POSTA_INTERVALLO=300

# ---------- Copie di backup ----------
# Password che cifra le copie sui dischi USB (Gestione caselle › Copie di
# backup). Generata da ./installa.sh se vuota. Senza questa le copie non si
# aprono: è sul foglio di ripristino. È diversa da quella di PiGreco Archivio.
BACKUP_PASSWORD=
# 1 = copie anche su un disco interno del server, preparato a mano una volta
# con:  mkfs.ext4 -L PIGRECO-INTERNO /dev/sdXN  (non montato dal sistema).
# Dei dischi interni si vedono solo le partizioni PIGRECO-*, mai formattate
# da qui. Un disco interno non protegge da furto o incendio: tenere anche
# un disco USB fuori dall'ufficio.
BACKUP_DISCHI_INTERNI=0
