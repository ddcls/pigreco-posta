# PiGreco Posta: copiare in .env e compilare (oppure lanciare ./installa.sh,
# che crea .env da questo file con password casuali).
# .env contiene password: non va mai pubblicato.

TZ=Europe/Rome

# ---------- Webmail ----------
# Indirizzo: http://<ip-server>:WEBMAIL_PORT/webmail/
WEBMAIL_PORT=8080

# Password di root del MySQL della webmail (serve solo al container per
# creare database e utente al primo avvio)
DB_ROOT_PASS=

# Database e utente MySQL della webmail
WEBMAIL_DB_NAME=webmail_digitale
WEBMAIL_DB_USER=webmail_user
WEBMAIL_DB_PASS=

# Chiave che cifra le password IMAP/SMTP salvate negli account (32 byte in
# base64). Generarla con:  openssl rand -base64 32
# NON cambiarla dopo aver creato gli account: le password non sarebbero più
# leggibili e andrebbero reinserite.
WEBMAIL_ENCRYPTION_KEY=

# Cartella dei dati di MySQL
WEBMAIL_DB_DIR=./dati/mysql

# Server IMAP proposto per i nuovi account: "posta" è la copia locale delle
# caselle di questo stesso compose (porta interna 143). Per leggere da un
# altro server IMAP indicarne qui nome e porta.
WEBMAIL_IMAP_HOST=posta
WEBMAIL_IMAP_PORT=143
WEBMAIL_IMAP_SECURITY=starttls
# 1 = verifica il certificato TLS del server IMAP (0 se è autofirmato, come
# quello creato da "posta" al primo avvio)
WEBMAIL_IMAP_TLS_VERIFY=0

# Collegamento con PiGreco Archivio: lasciare vuoto. Lo imposta a "/" la
# procedura che collega l'archivio (vedi README, "Collegare PiGreco Archivio").
ARCHIVIO_URL=

# ---------- Copia locale delle caselle ----------
# Cartella dei dati (caselle, account.conf, certificato): creata e assegnata
# a 5000:5000 dal container se non esiste
POSTA_DIR=./dati/posta

# Porte IMAP (STARTTLS) e IMAPS (SSL) per telefoni e programmi di posta.
# Sono quelle standard: cambiarle solo se sul server gira già un altro
# server IMAP (es. 1143 e 1993).
POSTA_IMAP_PORT=143
POSTA_IMAPS_PORT=993

# Pagina web "Gestione caselle"
POSTA_GESTIONE_PORT=8083

# Nome nel certificato autofirmato creato al primo avvio
POSTA_NOME_SERVER=posta.locale

# Secondi tra una sincronizzazione e la successiva
POSTA_INTERVALLO=300
